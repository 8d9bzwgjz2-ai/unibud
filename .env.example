# UNIBUD environment contract
# Copy to .env.local for local development. Never commit real secrets.

# Authentication
VITE_AUTH_ENABLED=false
BETTER_AUTH_URL=http://localhost:8080
BETTER_AUTH_SECRET=

# Production federated authentication
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Oracle Arc — UNIBUD's AI core (server-only; never exposed to the browser)
# Leave blank to keep every AI feature returning an honest "not configured"
# failure. A key alone is not enough: all three values are required.
ORACLE_ARC_API_URL=
ORACLE_ARC_MODEL=
ORACLE_ARC_API_KEY=
# Optional request tuning
ORACLE_ARC_TIMEOUT_MS=
ORACLE_ARC_MAX_ATTEMPTS=
# Per-user daily AI request limit across one product (default 200)
ORACLE_ARC_DAILY_LIMIT=
# Optional explicit fallback provider used only while Oracle Arc is down
ORACLE_ARC_FALLBACK_PROVIDER=
XAI_API_KEY=

# Production Postgres
# DATABASE_URL is preferred. Netlify Database may provide NETLIFY_DB_URL.
DATABASE_URL=
NETLIFY_DB_URL=
NETLIFY_DATABASE_URL=
NETLIFY_DATABASE_URL_UNPOOLED=
